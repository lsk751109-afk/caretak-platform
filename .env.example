NEXT_PUBLIC_SUPABASE_URL=https://zbtaylbrukbzhlydbvzt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# 서버 전용 값: 브라우저 코드와 GitHub 공개 저장소에 실제 값을 넣지 마세요.
SUPABASE_SECRET_KEY=your_secret_key
KCP_SITE_CODE=IP92M
KCP_CALLBACK_SECRET=create_a_long_random_secret

# KCP 인증서와 개인키는 Vercel 환경변수에 파일 원문을 직접 넣지 말고,
# 암호화된 비밀 저장소 또는 별도 결제 서버에서 관리하세요.
KCP_CERTIFICATE_PATH=/secure/path/to/certificate.pem
KCP_PRIVATE_KEY_PATH=/secure/path/to/private-key.pem
KCP_PRIVATE_KEY_PASSWORD=your_private_key_password
